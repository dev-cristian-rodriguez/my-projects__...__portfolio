{
  "permissions": {
    "allow": [
      "Read(.env.example)",
      "Read(.env.sample)",
      "Read(.env.template)",
      "Read(**/.env.example)",
      "Read(**/.env.sample)",
      "Read(**/.env.template)",
      "Edit(.env.example)",
      "Edit(.env.sample)",
      "Edit(.env.template)",
      "Edit(**/.env.example)",
      "Edit(**/.env.sample)",
      "Edit(**/.env.template)",
      "Write(.env.example)",
      "Write(.env.sample)",
      "Write(.env.template)",
      "Write(**/.env.example)",
      "Write(**/.env.sample)",
      "Write(**/.env.template)"
    ],
    "deny": [
      "Bash(npm install*)",
      "Bash(npm i *)",
      "Bash(npm add *)",
      "Bash(npm ci*)",
      "Bash(pnpm install*)",
      "Bash(pnpm add *)",
      "Bash(yarn add *)",
      "Bash(bun add *)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.env)",
      "Read(**/*.secret.*)",
      "Read(**/secrets.*)",
      "Read(**/secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(**/*.env)",
      "Edit(**/*.secret.*)",
      "Edit(**/secrets.*)",
      "Edit(**/secrets/**)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)",
      "Edit(**/*.p12)",
      "Edit(**/*.pfx)",
      "Write(**/.env)",
      "Write(**/.env.*)",
      "Write(**/*.env)",
      "Write(**/*.secret.*)",
      "Write(**/secrets.*)",
      "Write(**/secrets/**)",
      "Write(**/*.pem)",
      "Write(**/*.key)",
      "Write(**/*.p12)",
      "Write(**/*.pfx)"
    ],
    "ask": [],
    "additionalDirectories": [
      "/tmp"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "notify-send 'Claude Code' 'Task is ready.' --icon=utilities-terminal 2>/dev/null || true"
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {}
}